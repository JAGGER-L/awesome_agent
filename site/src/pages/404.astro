---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const home = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: "404",
    description: "Page not found. 页面未找到。",
    template: "splash",
    editUrl: false,
    hero: {
      title: "Signal lost. · 页面未找到",
      tagline:
        "This documentation page could not be found. Check the URL, use search, or return home. 未找到此文档页面，请检查地址、使用搜索或返回文档首页。",
      actions: [
        {
          text: "Back to Awesome Docs · 返回文档首页",
          link: home,
          icon: "left-arrow",
          variant: "primary",
        },
      ],
    },
  }}
/>
