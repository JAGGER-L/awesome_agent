---
const route = Astro.locals.starlightRoute;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const relativePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length).replace(/\/$/, "")
  : Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const canonicalRoute =
  relativePath === "zh-cn"
    ? ""
    : relativePath.startsWith("zh-cn/")
      ? relativePath.slice("zh-cn/".length)
      : relativePath;
const is404 = canonicalRoute === "404";
const englishCanonical = new URL(
  `${basePath}${canonicalRoute ? `${canonicalRoute}/` : ""}`,
  Astro.site ?? Astro.url,
).href;
const chineseCanonical = new URL(
  `${basePath}zh-cn/${canonicalRoute ? `${canonicalRoute}/` : ""}`,
  Astro.site ?? Astro.url,
).href;
type HeadEntry = (typeof route.head)[number];

const isCanonical = ({ tag, attrs }: HeadEntry) =>
  tag === "link" && attrs?.rel === "canonical";
const isAlternate = ({ tag, attrs }: HeadEntry) =>
  tag === "link" && attrs?.rel === "alternate";
const isOpenGraphUrl = ({ tag, attrs }: HeadEntry) =>
  tag === "meta" && attrs?.property === "og:url";

if (!is404 && route.isFallback === true) {
  throw new Error(`Missing localized source for documentation route: ${relativePath}`);
}

let head = [...route.head];
if (is404) {
  head = head.filter(
    (entry) => !isCanonical(entry) && !isAlternate(entry) && !isOpenGraphUrl(entry),
  );
  head.push({
    tag: "meta",
    attrs: { name: "robots", content: "noindex,follow" },
  });
} else {
  head = head.filter((entry) => !isAlternate(entry));
  head.push(
    {
      tag: "link",
      attrs: { rel: "alternate", hreflang: "en", href: englishCanonical },
    },
    {
      tag: "link",
      attrs: {
        rel: "alternate",
        hreflang: "zh-CN",
        href: chineseCanonical,
      },
    },
    {
      tag: "link",
      attrs: {
        rel: "alternate",
        hreflang: "x-default",
        href: englishCanonical,
      },
    },
  );
}
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
